# Tao file .env tu file nay va dat mat khau Admin manh.
# Khong bat buoc dan API Token vao .env: ban co the luu mot lan trong Admin > Chia se website.
# Neu muon quan ly bang bien moi truong thay vi giao dien Admin, co the dien CLOUDFLARE_API_TOKEN.
CLOUDFLARE_API_TOKEN=

# Ten Named Tunnel tu dong tao trong tai khoan Cloudflare.
CLOUDFLARE_TUNNEL_NAME=tuan-anh-store-public

# Docker Compose service noi bo cua website.
TA_STORE_TUNNEL_ORIGIN=http://app:3000

# Tuy chon hostname co san; bo trong neu se nhap trong Admin.
TA_STORE_PUBLIC_URL=

TA_STORE_ADMIN_USERNAME=ADMIN
TA_STORE_ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD_MIN_16_CHARS

# Bootstrap/admin access is loopback-only. Use SSH port forwarding from your PC.
TA_STORE_LOOPBACK_BIND=127.0.0.1
TA_STORE_LOOPBACK_PORT=3000
